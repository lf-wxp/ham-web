# Rust / Trunk 构建产物
/target
/dist
/tmp
crates/app/dist

# 由 `ham-web-tools postbuild` 生成，只存在于 dist/
public/sw.js
public/sitemap.xml

# 由 `cargo make i18n-pack` 生成（`data/i18n/` 词典源的运行时打包），
# 构建链会重新生成，不入库；`cargo make check` 先跑 i18n-pack 再校验。
public/data/i18n/

# Web Worker 构建产物：8 个 `*-worker` 目录里**全部**是 wasm-bindgen 生成的
# `*_worker.js` + `*_worker_bg.wasm`（`cargo make build-*-worker` 产出，无手写
# 文件 —— 统一入口是手写的 `public/decode-worker.js`，要提交）。
public/*-worker/
# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.history/

# env / logs
.env*
*.log
*.pem

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

.playwright-mcp

# Playwright
e2e/node_modules
e2e/test-results
e2e/test-results-*
e2e/playwright-report
test-results

