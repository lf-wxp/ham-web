{
  "CQ": {
    "en": "Calling Any Station",
    "category": "用语",
    "desc": "普遍呼叫，表示呼叫任何电台，CQ DX 表示只呼叫远方电台",
    "aliases": [
      "普遍呼叫",
      "CQ DX"
    ]
  },
  "DX": {
    "en": "Long Distance",
    "category": "用语",
    "desc": "远距离通联或远方电台，HF 上通常指其他大洲或稀有地区的电台"
  },
  "RST": {
    "en": "Readability, Strength, Tone",
    "category": "用语",
    "desc": "信号报告，R 为可懂度 1–5，S 为强度 1–9，T 为音调 1–9 且仅用于 CW，话音报告如 59，CW 报告如 599",
    "aliases": [
      "信号报告"
    ]
  },
  "字母解释法": {
    "en": "Phonetic Alphabet",
    "category": "用语",
    "desc": "用固定单词代表字母以避免听错，如 A Alfa、B Bravo、C Charlie，话音通联拼读呼号时使用",
    "aliases": [
      "语音字母",
      "ITU 拼读字母"
    ]
  },
  "莫尔斯电码": {
    "en": "Morse Code",
    "category": "用语",
    "desc": "用长短不同的点划组合表示字母和数字的编码，是 CW 通信的基础",
    "aliases": [
      "摩尔斯电码",
      "电码"
    ]
  },
  "WPM": {
    "en": "Words Per Minute",
    "category": "用语",
    "desc": "每分钟发送的单词数，是衡量 CW 收发速度的单位"
  },
  "SOS": {
    "en": "Distress Signal",
    "category": "用语",
    "desc": "国际通用的莫尔斯遇险信号，发送为嘀嘀嘀嗒嗒嗒嘀嘀嘀，听到后应立即停止其他通信并协助",
    "aliases": [
      "遇险信号"
    ]
  },
  "MAYDAY": {
    "en": "Mayday",
    "category": "用语",
    "desc": "话音通信中的遇险呼叫用语，连呼三遍，表示生命或船舶航空器面临严重紧急危险"
  },
  "QLF": {
    "en": "Poor Keying / Fist",
    "category": "用语",
    "desc": "发报手法差、键控不熟练，业余界惯用语",
    "common": false
  },
  "QRA": {
    "en": "Name of Station",
    "category": "用语",
    "desc": "问你台的名称是什么，答我台的名称是某某"
  },
  "QRB": {
    "en": "Distance Between Stations",
    "category": "用语",
    "desc": "两电台之间的距离",
    "common": false
  },
  "QRD": {
    "en": "Where Are You Bound",
    "category": "用语",
    "desc": "你从哪里来、要到哪里去",
    "common": false
  },
  "QRG": {
    "en": "Exact Frequency",
    "category": "用语",
    "desc": "你台的准确频率是多少，答我台的频率是…",
    "common": false
  },
  "QRH": {
    "en": "Frequency Varies",
    "category": "用语",
    "desc": "我的频率是否有漂移，答你的频率有漂移",
    "common": false
  },
  "QRI": {
    "en": "Tone of Transmission",
    "category": "用语",
    "desc": "我的发射音调如何，答你的音调…",
    "common": false
  },
  "QRK": {
    "en": "Readability",
    "category": "用语",
    "desc": "问我的信号可懂度如何，答你的信号可懂度为 1–5 级"
  },
  "QRL": {
    "en": "Busy",
    "category": "用语",
    "desc": "问你忙吗，答我正忙请勿干扰，业余通联中常用来询问频率是否已被占用"
  },
  "QRM": {
    "en": "Man-made Interference",
    "category": "用语",
    "desc": "人为干扰，指其他电台或电气设备造成的干扰"
  },
  "QRN": {
    "en": "Static",
    "category": "用语",
    "desc": "天电干扰，指雷电等自然现象产生的噪声"
  },
  "QRO": {
    "en": "Increase Power",
    "category": "用语",
    "desc": "增加发射功率，业余中也泛指大功率工作"
  },
  "QRP": {
    "en": "Reduce Power",
    "category": "用语",
    "desc": "降低发射功率，业余中也指小功率通信，CW 通常不超过 5W"
  },
  "QRQ": {
    "en": "Send Faster",
    "category": "用语",
    "desc": "请发快一点"
  },
  "QRS": {
    "en": "Send Slower",
    "category": "用语",
    "desc": "请发慢一点"
  },
  "QRT": {
    "en": "Stop Sending",
    "category": "用语",
    "desc": "停止发送，也常表示准备关机下线"
  },
  "QRU": {
    "en": "Nothing for You",
    "category": "用语",
    "desc": "问你有什么要给我的吗，答我没有什么要给你的"
  },
  "QRV": {
    "en": "Ready",
    "category": "用语",
    "desc": "我已准备好"
  },
  "QRW": {
    "en": "Relay To",
    "category": "用语",
    "desc": "请转告…",
    "common": false
  },
  "QRX": {
    "en": "Wait",
    "category": "用语",
    "desc": "请等待，稍后再叫我"
  },
  "QRZ": {
    "en": "Who Is Calling Me",
    "category": "用语",
    "desc": "谁在呼叫我，常用于没听清对方呼号时"
  },
  "QSA": {
    "en": "Signal Strength",
    "category": "用语",
    "desc": "我的信号强度如何，答你的信号强度为 1–5 级",
    "common": false
  },
  "QSB": {
    "en": "Fading",
    "category": "用语",
    "desc": "信号衰落，信号强度时强时弱"
  },
  "QSD": {
    "en": "Keying Defective",
    "category": "用语",
    "desc": "我的键控是否有缺陷，答你的键控有缺陷",
    "common": false
  },
  "QSK": {
    "en": "Full Break-In",
    "category": "用语",
    "desc": "全插入，能否在所发电码的间隙中接收信号",
    "common": false
  },
  "QSL": {
    "en": "Acknowledge Receipt",
    "category": "用语",
    "desc": "确认收妥，也指通联确认卡片"
  },
  "QSM": {
    "en": "Repeat Last Message",
    "category": "用语",
    "desc": "请重复最后一条消息",
    "common": false
  },
  "QSN": {
    "en": "I Heard You",
    "category": "用语",
    "desc": "我听到你了",
    "common": false
  },
  "QSO": {
    "en": "Contact",
    "category": "用语",
    "desc": "与某电台进行的双向联络，一次完整通联称为一个 QSO",
    "aliases": [
      "联络"
    ]
  },
  "QSP": {
    "en": "Relay",
    "category": "用语",
    "desc": "代为转发消息"
  },
  "QST": {
    "en": "General Call to All Amateurs",
    "category": "用语",
    "desc": "致全体业余电台的通告"
  },
  "QSV": {
    "en": "Send a Series of V",
    "category": "用语",
    "desc": "请发送一连串 V 用于调试",
    "common": false
  },
  "QSX": {
    "en": "Listen On Frequency",
    "category": "用语",
    "desc": "请在…频率守听",
    "common": false
  },
  "QSY": {
    "en": "Change Frequency",
    "category": "用语",
    "desc": "改变频率，如 QSY 145.500 表示转到该频率继续通联"
  },
  "QSZ": {
    "en": "Repeat Each Word or Group",
    "category": "用语",
    "desc": "请把每个词或组重复发送多次",
    "common": false
  },
  "QTC": {
    "en": "Telegrams to Send",
    "category": "用语",
    "desc": "你有多少电报要发，答我有…份电报",
