target/
dist/
tmp/
# 构建期生成物（`.gitignore` 同样排除），本地可能存在旧版本：
#   * 三个解码 Worker 的胶水与 wasm —— Dockerfile 里由 wasm-bindgen 重新生成；
#   * postbuild 的 sw.js / sitemap.xml —— 只应存在于 dist/，不该从源码树带进镜像。
# 排除它们，保证 docker build 走的是与干净 checkout 完全一致的路径（否则本地残留
# 会进构建上下文，Dockerfile 末尾的产物断言也无法区分「新生成」与「旧残留」）。
public/apt-worker/apt_worker.js
public/apt-worker/apt_worker_bg.wasm
public/sstv-worker/sstv_worker.js
public/sstv-worker/sstv_worker_bg.wasm
public/wspr-worker/wspr_worker.js
public/wspr-worker/wspr_worker_bg.wasm
public/sw.js
public/sitemap.xml
node_modules/
.next/
.git/
.github/
.codebuddy/
.playwright-mcp/
.idea/
.vscode/
**/.DS_Store
*.log
e2e/
